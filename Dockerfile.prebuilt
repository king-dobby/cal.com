# Deploy target for Coolify — pulls the image instead of building it.
#
# The real build is ./Dockerfile, and it does not fit on the Coolify host: the
# Next build completes (183/183 pages) and the build container is then killed
# with exit 255, the signature of an OOM. The same Dockerfile builds cleanly on
# the Henry box (15GB RAM), so the image is built there and pushed to GHCR.
#
#   ssh root@178.156.208.39 /root/build_cal.sh     # build + push
#
# Coolify then "builds" this file, which is a pull and costs no memory. Point
# dockerfile_location back at /Dockerfile if the host is ever given more RAM.
FROM ghcr.io/king-dobby/calcom:latest

# Run on Node 22. The image above was built on Node 20, which reached end of
# life on 2026-04-30 and gets no security fixes. Only the node binary is
# swapped; the app's native modules load the same on both (checked on the
# Coolify host on 2026-10-25, where cal.ait.best already runs this).
COPY --from=node:22.23.4-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d /usr/local/bin/node /usr/local/bin/node
